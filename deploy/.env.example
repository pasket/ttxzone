# Copy to .env next to docker-compose.yml. What each setting does and the rest
# of them: docs/deployment.md, section 2, and .env.example at the repository's
# root. Keep this file readable only by the operator.

# --- Images ---
# A release (docs/deployment.md, section 7). Pin it: "latest" moves.
TTX_VERSION=0.1.0

# --- Addresses ---
# The hostname people use, with its certificate in certs/ (fullchain.pem and
# privkey.pem, readable by uid 101: on Linux chown 101:101 and chmod 600 the
# key; with Docker Desktop chmod 644).
TTX_SERVER_NAME=ttx.example.org
# What the proxy publishes: a port, or address:port to bind one interface.
# TTX_HTTP_BIND=80
# TTX_HTTPS_BIND=443

# --- Secrets ---
# Replace every change-me: the API refuses to start with them.
POSTGRES_USER=ttx_admin
# openssl rand -hex 16
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ttx_zone
# openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# openssl rand -base64 32 | tr '+/' '-_'
# It decrypts every secret the app stores: keep a copy apart from the backups.
DATA_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- The Players' public face (--profile public; section 9) ---
# Its hostname, with its certificate in certs-public/.
# TTX_PUBLIC_SERVER_NAME=play.example.org
# TTX_PUBLIC_HTTP_BIND=203.0.113.10:80
# TTX_PUBLIC_HTTPS_BIND=203.0.113.10:443
# Links in emails, when invitations go to Players outside.
# TTX_EMAIL_BASE_URL=https://play.example.org

# --- Optional ---
# Pin the tenancy rule and the outgoing email here, or set them from Platform.
# TENANCY_MODE=managed
# EMAIL_TRANSPORT=smtp
# With WEB_CONCURRENCY above 1 (section 10), also LOG_FILE_MAX_MB=0 (section 5).
# WEB_CONCURRENCY=1
