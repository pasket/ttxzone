# The DMZ host's settings. Copy to .env next to this docker-compose.yml and keep
# it readable only by the operator. docs/deployment.md, section 9.

# --- Images: the same release as the internal host ---
TTX_VERSION=0.1.0

# --- Addresses ---
# The hostname Players use, with its certificate in certs/.
TTX_PUBLIC_SERVER_NAME=play.example.org
# What the proxy publishes: a port, or address:port on the Internet-facing interface.
# TTX_PUBLIC_HTTP_BIND=203.0.113.10:80
# TTX_PUBLIC_HTTPS_BIND=203.0.113.10:443

# --- The database, inside (internal-host.yml publishes it) ---
# The name must match PostgreSQL's certificate; put the CA that signed it in
# db-ca/root.crt. TTX_DB_SSLMODE=require encrypts without checking the name;
# disable only on a trusted link.
TTX_DB_HOST=db.internal.example.org
# TTX_DB_PORT=5432
# TTX_DB_SSLMODE=verify-full
POSTGRES_USER=ttx_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ttx_zone

# --- Shared uploads: the same files the internal host mounts ---
TTX_UPLOADS_PATH=/mnt/ttx-uploads

# --- Secrets: exactly the internal host's values ---
# Sessions are signed with SECRET_KEY, and second factors are decrypted with
# DATA_ENCRYPTION_KEY: with other values nobody can sign in here.
SECRET_KEY=change-me-copy-from-the-internal-host
DATA_ENCRYPTION_KEY=change-me-copy-from-the-internal-host
