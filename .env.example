# --- Postgres ---
POSTGRES_USER=ttx_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ttx_zone
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend ---
# development on a workstation (plain HTTP). Unset, the backend runs as
# production: Secure cookies (HTTPS only), and the example secrets refused.
ENVIRONMENT=development
# What this process runs (docs/deployment.md, section 8): all (API and
# background loops), api-internal (API only) or worker (loops only).
# APP_ROLE=all
# RUN_MIGRATIONS=true
# Per uvicorn worker: database connections and requests handled at once
# (docs/deployment.md, section 10). WEB_CONCURRENCY: workers per container.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=30
# MAX_CONCURRENT_REQUESTS=30
# Failed sign-ins from one address in 15 minutes before it's locked out for
# 15 (docs/architecture/session-policy.md). Raise it for a very large room
# behind one public address.
# LOGIN_FAILURES_PER_ADDRESS=100
# WEB_CONCURRENCY=1
# Deployment-wide rules (password/MFA policy, legal documents) cached per
# process for this long; a change in Platform applies at once where saved.
# INSTANCE_CACHE_SECONDS=5
LOG_LEVEL=INFO
# backend/logs/*.log rotate at this size, keeping this many older copies
# (10 MB x 6 files = 60 MB per log at most). LOG_FILE_MAX_MB=0 leaves
# rotation to the server's logrotate (needed with several backend processes).
LOG_FILE_MAX_MB=10
LOG_FILE_BACKUPS=5
# Production image only: the reverse proxy's address or network, whose
# X-Forwarded-For the backend believes (docs/deployment.md, section 4).
# Never "*" behind a proxy that appends to that header.
# FORWARDED_ALLOW_IPS=172.30.0.0/24
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en","es"]

# --- Backend: Auth ---
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# Or SECRET_KEY_FILE (and POSTGRES_PASSWORD_FILE): read from that file, a
# Docker/Kubernetes secret. A value set directly wins over its file.
# SECRET_KEY_FILE=/run/secrets/secret_key
JWT_ALGORITHM=HS256
SESSION_IDLE_MINUTES_PRIVILEGED=30
SESSION_IDLE_MINUTES_PLAYER=60
SESSION_ABSOLUTE_HOURS=12
STEP_UP_MINUTES=15

# --- Backend: Tenancy (docs/features/instance-tenancy.md) ---
# Who may found organizations: open (any account), single (one organization,
# founded once) or managed (only an instance administrator, from Platform).
# Leave unset to let the instance administrator choose from the web (until
# they do: managed, one organization); set it to pin the rule here
# (Platform then shows it read-only).
# TENANCY_MODE=managed
# TENANCY_MAX_ORGANIZATIONS=5
# Instance administrators grant and revoke the role from the web (default
# true). false leaves it to the server's console (scripts.instance_admin).
# INSTANCE_ADMIN_WEB_GRANTS=false
# Platform's activity log forwarded to a SIEM (Platform -> Activity log):
# how often queued entries are sent, and whether plain http:// collectors
# are accepted (internal networks only; https is required by default).
# AUDIT_WEBHOOK_POLL_SECONDS=10
# AUDIT_WEBHOOK_ALLOW_HTTP=false

# --- Backend: Encryption key (docs/architecture/email.md) ---
# Required: encrypts the secrets kept in the database (TOTP secrets, the
# SIEM webhook's, the SMTP password and single sign-on client secret set
# from Platform, queued messages). Keep it apart from SECRET_KEY and out of
# database backups. Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_'
DATA_ENCRYPTION_KEY=change-me-generate-a-fernet-key
# DATA_ENCRYPTION_KEY_FILE=/run/secrets/data_encryption_key

# --- Backend: Outgoing email (docs/architecture/email.md) ---
# Leave EMAIL_TRANSPORT unset to configure email from Platform -> Email; set
# it to pin the whole configuration here (Platform then shows it read-only).
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM_ADDRESS=noreply@company.com
# EMAIL_FROM_NAME=TTX-Zone
# EMAIL_REPLY_TO=security-team@company.com
# SMTP_HOST=smtp.company.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=noreply@company.com
# SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# Local mail catcher (docker compose --profile mail up -d mailpit, UI on
# http://localhost:8025): SMTP_HOST=mailpit, SMTP_PORT=1025,
# SMTP_SECURITY=none and EMAIL_ALLOW_INSECURE=true (plain text, unverified
# certificates and odd ports -- never towards the Internet).
# EMAIL_ALLOW_INSECURE=false
# Every account confirms its address again after this many days (1-730;
# 0 = never). Unset: decided in Platform -> Email, off by default.
# EMAIL_RECONFIRMATION_DAYS=365

# --- Backend: Single sign-on (docs/architecture/sso.md) ---
# Where people reach the app, as their browser sees it (no path): the
# provider sends them back to <PUBLIC_BASE_URL>/api/v1/auth/oidc/callback,
# registered with it exactly. Required for single sign-on.
# PUBLIC_BASE_URL=http://localhost:5173
# Leave OIDC_PROVIDER unset to configure it from Platform -> Single sign-on;
# set it to pin the whole configuration here. "entra" (Microsoft Entra ID,
# one tenant) or "generic" (any OpenID Connect provider by its issuer URL).
# OIDC_PROVIDER=entra
# OIDC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# OIDC_ISSUER_URL=https://idp.company.com/realms/ttx
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_DISPLAY_NAME=Microsoft
# Create an account (no role, no password) on someone's first sign-in.
# OIDC_ALLOW_JIT=false
# The provider's second factor (amr contains "mfa") counts as TOTP.
# OIDC_TRUST_PROVIDER_MFA=true
# A provider on plain http (a local test provider only).
# OIDC_ALLOW_INSECURE=false

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Where a modified build offers its source code to its users (AGPL section 13);
# leave unset to link the original repository from About.
# VITE_SOURCE_URL=https://github.com/your-org/your-fork
