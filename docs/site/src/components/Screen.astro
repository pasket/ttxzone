---
// A screenshot in the reader's theme, linking to its full size. The images
// come from `npm run docs:screenshots` in frontend/.
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
}

const { name, alt } = Astro.props;
const screens = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', {
  eager: true,
});
const load = (theme: string) => {
  const screen = screens[`../assets/screens/${name}-${theme}.png`];
  if (!screen) throw new Error(`No ${theme} screenshot named ${name}`);
  return screen.default;
};
const themes = ['dark', 'light'].map((theme) => ({ theme, src: load(theme) }));
const full = await Promise.all(themes.map(({ src }) => getImage({ src, format: 'webp' })));
---

<figure class="not-content screen">
  {
    themes.map(({ theme, src }, index) => (
      <div class={theme === 'dark' ? 'light:sl-hidden' : 'dark:sl-hidden'}>
        <a href={full[index].src} aria-label={`${alt} (full size)`}>
          <Image src={src} alt={alt} widths={[720, 1440]} sizes="(min-width: 50rem) 720px, 100vw" />
        </a>
      </div>
    ))
  }
</figure>

<style>
  .screen {
    margin-block: 1.5rem;
  }
  .screen a {
    display: block;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    overflow: hidden;
  }
  .screen a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .screen img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
