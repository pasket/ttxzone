---
import Diagram from './Diagram.astro';

const tip = 'url(#diagram-what-each-step-waits-for-a)';
const steps = [
  ['Needs analysis', 'Approved'],
  ['MSEL', 'Ready'],
  ['Session plan', 'Ready'],
];
---

<Diagram
  title="What each step waits for"
  description="The needs analysis must be approved before the MSEL opens. The MSEL must be ready before the session plan can be ready. The session starts only when the MSEL and the session plan are both ready."
  width={720}
  height={104}
>
  {
    steps.map(([name, state], index) => {
      const x = 8 + index * 180;
      return (
        <g>
          <rect class="box" x={x} y="14" width="150" height="72" rx="4" />
          <text class="strong" x={x + 12} y="42">{name}</text>
          <text class="small" x={x + 12} y="66">{state}</text>
          <path class="line" d={`M${x + 150} 50h29`} marker-end={tip} />
        </g>
      );
    })
  }
  <rect class="on" x="548" y="14" width="150" height="72" rx="4"></rect>
  <text class="strong" x="560" y="42">Session</text>
  <text class="small" x="560" y="66">Can start</text>
</Diagram>
