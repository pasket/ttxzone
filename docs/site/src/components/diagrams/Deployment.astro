---
import Diagram from './Diagram.astro';

const tip = 'url(#diagram-services-of-an-instance-a)';
---

<Diagram
  title="Services of an instance"
  description="People reach the proxy over HTTPS. The proxy forwards to the frontend and to the API. The API and the worker use PostgreSQL and the uploads volume. Optionally, Players on the Internet reach a public proxy and a public API in a DMZ, which use the same PostgreSQL and uploads."
  width={720}
  height={330}
>
  <rect class="zone" x="8" y="10" width="704" height="192" rx="4"></rect>
  <text class="small" x="20" y="30">Your network</text>
  <rect class="zone" x="8" y="222" width="432" height="100" rx="4"></rect>
  <text class="small" x="20" y="242">DMZ, optional: the Players' public face</text>

  <rect class="on" x="24" y="70" width="110" height="56" rx="4"></rect>
  <text class="strong mid" x="79" y="96">proxy</text>
  <text class="small mid" x="79" y="114">TLS</text>

  <rect class="box" x="194" y="42" width="120" height="48" rx="4"></rect>
  <text class="strong mid" x="254" y="71">frontend</text>
  <rect class="box" x="194" y="108" width="120" height="48" rx="4"></rect>
  <text class="strong mid" x="254" y="137">api</text>
  <rect class="box" x="374" y="42" width="120" height="48" rx="4"></rect>
  <text class="strong mid" x="434" y="71">worker</text>
  <rect class="box" x="554" y="42" width="140" height="48" rx="4"></rect>
  <text class="strong mid" x="624" y="71">postgres</text>
  <rect class="box" x="554" y="126" width="140" height="48" rx="4"></rect>
  <text class="strong mid" x="624" y="155">uploads</text>

  <path class="line" d="M134 90c30 0 30-24 59-24" marker-end={tip}></path>
  <path class="line" d="M134 106c30 0 30 26 59 26" marker-end={tip}></path>
  <path class="line" d="M314 122H524V78H553" marker-end={tip}></path>
  <path class="line" d="M314 142h239" marker-end={tip}></path>
  <path class="line" d="M494 58h59" marker-end={tip}></path>

  <rect class="box" x="24" y="254" width="130" height="52" rx="4"></rect>
  <text class="strong mid" x="89" y="285">proxy-public</text>
  <rect class="box" x="214" y="254" width="130" height="52" rx="4"></rect>
  <text class="strong mid" x="279" y="285">api-public</text>
  <path class="line" d="M154 280h59" marker-end={tip}></path>
  <path class="line" d="M344 270H624V175" marker-end={tip}></path>
  <path class="line" d="M344 290H704V66H695" marker-end={tip}></path>
  <text class="small" x="456" y="312">The same database and files</text>
</Diagram>
